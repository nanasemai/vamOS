CONFIG_ARCH_SDM845=y

# OnePlus 6 Display - built-in for early boot
CONFIG_DRM_PANEL_SAMSUNG_SOFEF00=y

# CRITICAL: Touchscreen drivers - MUST be built-in (not modules)
# These are required before rootfs can be mounted (no initrd)
CONFIG_I2C_QCOM_GENI=y
CONFIG_RMI_CORE=y
CONFIG_RMI_I2C=y
CONFIG_QCOM_SPMI_HAPTICS=y

# CRITICAL: UFS storage driver - MUST be built-in for rootfs access
CONFIG_SCSI_UFS_QCOM=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI_UFS_QCOM=y

# OnePlus 6 Battery - module
CONFIG_BATTERY_BQ27XXX=m

# OnePlus 6 Camera Sensors - modules
CONFIG_VIDEO_IMX371=m
CONFIG_VIDEO_IMX376=m
CONFIG_VIDEO_IMX519=m
CONFIG_VIDEO_LC898217XC=m

# Disable OnePlus 6T specific configs
CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01=n
CONFIG_SND_SOC_TFA98XX=n

# Disable other phone camera sensors
CONFIG_VIDEO_IMX363=n
CONFIG_VIDEO_IMX355=n
CONFIG_VIDEO_IMX219=n
CONFIG_VIDEO_OV5645=n

# Camera subsystem - built-in for core functionality
CONFIG_MSM_CAMERA_COMMON=y
CONFIG_QCOM_CSI_PHY=y

# Qualcomm Serial Console (required for boot messages)
CONFIG_SERIAL_QCOM_MSM=y
CONFIG_SERIAL_QCOM_MSM_CONSOLE=y
CONFIG_SERIAL_MSM_GENI=y

# USB Serial Gadget Console
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_G_SERIAL=y

# EROFS filesystem support
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_DEBUG=y

CONFIG_V4L2_MEM2MEM_DEV=m
CONFIG_VIDEOBUF2_VMALLOC=y

# Media support
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y

# Qualcomm platform - core components built-in
CONFIG_QCOM_GSBI=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_SPMI_VADC=y