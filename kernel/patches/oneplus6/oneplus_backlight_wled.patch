+/* PMI8998 WLED backlight. The driver is built in (CONFIG_BACKLIGHT_QCOM_WLED)
+ * but the node was left disabled upstream, so no backlight device was ever
+ * created. The LED settings mirror the other PMI8998 boards in this tree.
+ */
+&pmi8998_wled {
+	qcom,current-limit-microamp = <20000>;
+	qcom,ovp-millivolt = <29600>;
+	qcom,switching-freq = <800>;
+
+	status = "okay";
+};
