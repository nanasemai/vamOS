#!/usr/bin/env bash
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" >/dev/null && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd "$(dirname "$SOURCE")/.." >/dev/null && pwd)"

setup() {
  git -C "$DIR" submodule update --init --depth 1
  if [ "$(uname)" = "Linux" ]; then
    UDEV_RULES="/etc/udev/rules.d/99-qualcomm-edl.rules"
    if [ ! -f "$UDEV_RULES" ]; then
      echo "Setting up udev rules for Qualcomm EDL..."
      sudo tee "$UDEV_RULES" > /dev/null <<'EOF'
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9008", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="3801", ATTR{idProduct}=="9008", MODE="0666"
EOF
      sudo udevadm trigger --attr-match=subsystem=usb
    fi
  fi
}

case "${1:-}" in
  setup)    setup ;;
  build)
    case "${2:-}" in
      system) exec "$DIR/tools/build/build_system.sh" ;;
      kernel|oneplus6)
        # 本分支只服务一加6/6T：上游 DTS + initramfs + fastboot，
        # 和 Comma 那套（EDL + VBLE 签名 + Spectra 外挂驱动）是两套东西。
        # `kernel` 留作 `oneplus6` 的别名，因为文档和记忆里一直说
        # `./vamos build kernel`。
        "$DIR/tools/build/build_kernel_oneplus6.sh" && "$DIR/tools/build/build_bootimg_oneplus6.sh" ;;
      *)      echo "Usage: vamos build <kernel|oneplus6|system>"; exit 1 ;;
    esac ;;
  flash)
    case "${2:-}" in
      oneplus6|all)
        # fastboot 刷机，不是 EDL。`all` 保留是因为文档一直这么写。
        exec "$DIR/tools/flash/oneplus6.sh" "${3:-}" ;;
      *)      echo "Usage: vamos flash <oneplus6|all> [--yes]"; exit 1 ;;
    esac ;;
  profile)
    shift
    exec "$DIR/tools/profile/rootfs.sh" "$@" ;;
  sync)
    shift
    exec "$DIR/tools/sync/openpilot.sh" "$@" ;;
  *)
    echo "Usage: vamos <setup|build|flash|profile|sync>"
    echo ""
    echo "  本分支 (oneplus-mainline) 只服务一加6 (enchilada) / 一加6T (fajita)。"
    echo "  刷机走 fastboot，不走 EDL。"
    echo ""
    echo "  setup              Initialize submodules and udev rules"
    echo "  build kernel       构建内核 + 打包 boot.img（等价 build oneplus6）"
    echo "  build oneplus6     同上，明示设备"
    echo "  build system       Build the system image"
    echo "  flash oneplus6     fastboot 刷机: boot_a/b, userdata, vbmeta_a/b"
    echo "  flash all          同上"
    echo "  profile [diff]     Profile rootfs or diff two profiles"
    echo "  sync [ref]         Sync openpilot's dependency list and relock"
    echo ""
    echo "  设备切换: DEVICE=fajita ./vamos build kernel    # 一加6T"
    echo "  跳过确认: ./vamos flash oneplus6 --yes"
    echo "  WARNING: flash 会擦除 userdata（全部设备数据）。"
    echo "           详见 docs/oneplus6-retarget-plan-2026-10-23.md"
    exit 1 ;;
esac
